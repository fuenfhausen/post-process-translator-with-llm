# Azure Translator
AZURE_TRANSLATOR_ENDPOINT=https://<your-translator>.cognitiveservices.azure.com

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<your-openai>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Azure Blob Storage (for document translation)
AZURE_STORAGE_ACCOUNT_URL=https://<your-storage>.blob.core.windows.net
AZURE_STORAGE_CONTAINER_SOURCE=translate-source
AZURE_STORAGE_CONTAINER_TARGET=translate-target

# App settings
LOG_LEVEL=INFO
